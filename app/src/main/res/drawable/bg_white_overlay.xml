<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna putih semi transparan -->
    <solid android:color="#80FFFFFF" /> <!-- 80 = alpha transparan -->

    <!-- Sudut melengkung -->
    <corners android:radius="16dp" />

    <!-- Optional: bayangan tipis -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>
