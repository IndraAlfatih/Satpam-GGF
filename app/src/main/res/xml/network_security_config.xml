<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production (HTTPS aman, tidak perlu cleartext) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">osiqcpp.ggfsystem.com</domain>
    </domain-config>

    <!-- Development (HTTPS aman, tidak perlu cleartext) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">osiqcppdev.ggfsystem.com</domain>
    </domain-config>

    <!-- Local testing (HTTP, harus diizinkan cleartext) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.3</domain>
    </domain-config>
</network-security-config>
