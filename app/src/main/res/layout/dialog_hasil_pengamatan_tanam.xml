<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="3dp"
    app:cardCornerRadius="5dp"
    app:cardElevation="3dp"
    app:cardMaxElevation="0dp"
    app:cardUseCompatPadding="false">


    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="3dp">


                <LinearLayout
                    android:id="@+id/linearLayoutch4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_layout_white_2"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayoutch3"
                    tools:ignore="MissingConstraints">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pencapaian"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jarak Tanam Dalam Baris"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        />

                    <!-- Dropdown tahun dan bulan -->
                    <LinearLayout
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="% Pencapaian"
                                android:textSize="14sp"
                                android:paddingStart="10dp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                            <TextView
                                android:id="@+id/mPencapaianJTDB"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="40%"
                                android:paddingStart="10dp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Avg. JTDB"
                                android:textSize="14sp"
                                android:paddingStart="10dp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                            <TextView
                                android:id="@+id/mAvgJTDB"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="40%"
                                android:paddingStart="10dp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                        </LinearLayout>

                    </LinearLayout>
                    <!-- _______________________________________________________________________________ -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jarak Tanam Antar Baris"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        />

                    <!-- Dropdown tahun dan bulan -->
                    <LinearLayout
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="% Pencapaian"
                                android:textSize="14sp"
                                android:paddingStart="10dp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                            <TextView
                                android:id="@+id/mPencapaianJTAB"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="40%"
                                android:paddingStart="10dp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Avg. JTAB"
                                android:textSize="14sp"
                                android:paddingStart="10dp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                            <TextView
                                android:id="@+id/mAvgJTAB"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="40%"
                                android:paddingStart="10dp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                        </LinearLayout>

                    </LinearLayout>
                    <!-- _______________________________________________________________________________ -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kedalaman Tanam"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        />

                    <!-- Dropdown tahun dan bulan -->
                    <LinearLayout
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="% Pencapaian"
                                android:textSize="14sp"
                                android:paddingStart="10dp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                            <TextView
                                android:id="@+id/mPencapaianKD"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="19%"
                                android:paddingStart="10dp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Avg. KD"
                                android:textSize="14sp"
                                android:paddingStart="10dp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                            <TextView
                                android:id="@+id/mAvgKD"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:text="99%"
                                android:paddingStart="10dp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                        </LinearLayout>



                    </LinearLayout>

                    <!-- Dropdown tahun dan bulan -->
                    <LinearLayout
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Total Pencapaian"
                                android:textSize="14sp"
                                android:paddingStart="10dp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                            <TextView
                                android:id="@+id/mTotalPencapaian"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="19%"
                                android:paddingStart="10dp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_weight="1"
                                />

                        </LinearLayout>



                    </LinearLayout>




                    <!-- Dropdown tahun dan bulan -->
                    <LinearLayout
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <!-- Grade Section -->
                            <TextView
                                android:id="@+id/mGrade"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Masuk Standar"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/green1"
                                android:layout_below="@id/mTotalPencapaian"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="16dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginRight="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:weightSum="2">



                        </LinearLayout>

                    </LinearLayout>
                    <!-- _______________________________________________________________________________ -->


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>
</androidx.cardview.widget.CardView>