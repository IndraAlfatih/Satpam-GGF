<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    >
    <!-- Dropdown -->
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_layout_white_2"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Dropdown wilayah dan aktifitas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_marginRight="5dp"
                    android:id="@+id/textagregat"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Titik Sample ke: 1"
                    android:maxLines="1"
                    android:lines="1"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_weight="1"

                    />

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:orientation="vertical">

            </LinearLayout>


        </LinearLayout>
        <!-- _______________________________________________________________________________ -->

        <!-- Dropdown wilayah dan aktifitas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:layout_marginRight="5dp"
                    android:id="@+id/lolosayakan"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_edit"
                    android:hint="Lolos Ayakan"
                    android:maxLines="1"
                    android:lines="1"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_weight="1"

                    />

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:layout_marginRight="5dp"
                    android:id="@+id/tidaklolosayakan"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_edit"
                    android:hint="Tidak Lolos Ayakan"
                    android:maxLines="1"
                    android:lines="1"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_weight="1"

                    />

            </LinearLayout>


        </LinearLayout>
        <!-- _______________________________________________________________________________ -->

        <!-- Dropdown wilayah dan aktifitas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:layout_marginRight="5dp"
                    android:id="@+id/aplikasipinggiran"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_edit"
                    android:hint="%Lolos Ayakan"
                    android:maxLines="1"
                    android:lines="1"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_weight="1"

                    />

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:layout_marginRight="5dp"
                    android:id="@+id/kerataanaplikasi"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_edit"
                    android:hint="Kerataan Aplikasi"
                    android:maxLines="1"
                    android:lines="1"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_weight="1"

                    />

            </LinearLayout>


        </LinearLayout>
        <!-- _______________________________________________________________________________ -->

        <!-- Dropdown Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/liner2"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_below="@+id/linier1"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_background4"
                    android:orientation="horizontal"/>

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="70dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/removeagregat"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_silang"
                    android:textSize="16sp"
                    android:gravity="center_vertical"
                    android:layout_weight="1"
                    />

            </LinearLayout>


        </LinearLayout>
        <!-- _______________________________________________________________________________ -->



    </LinearLayout>
    <!-- _______________________________________________________________________________ -->

</androidx.cardview.widget.CardView>