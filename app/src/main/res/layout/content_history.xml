<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="5dp">

    <RelativeLayout
        android:id="@+id/rltvhasil1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_layout_white_2"
        android:padding="3dp"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:id="@+id/crd1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/profile1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentLeft="true"
                android:src="@drawable/prfll"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/profile"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="Indra Yulianto"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mLokasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/mmedium"
                    android:text="153D"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mTanggalHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="Tanggal history"
                    android:textColor="@color/gray"
                    android:textSize="14sp"
                    android:textStyle="italic" />


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/crd2"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_below="@+id/crd1"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_background4"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/crd3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/crd2"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/crd2"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="vertical"
                android:layout_weight="1"
                android:weightSum="2">

                <TextView
                    android:id="@+id/mPG"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/mmedium"
                    android:text="Plantation Group 1"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mCreated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="Timestamp"
                    android:textColor="@color/gray"
                    android:textSize="14sp"
                    android:textStyle="italic" />



            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/crd2"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="vertical"
                android:layout_weight="1">

                <Button
                    android:id="@+id/mHapus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginBottom="16dp"
                    android:layout_gravity="right"
                    android:layout_below="@id/crd6"
                    android:text="Hapus"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_btngradient3"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:drawableLeft="@drawable/baseline_delete_sweep_24"
                    android:drawablePadding="8dp"/>

            </LinearLayout>

        </LinearLayout>







    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>