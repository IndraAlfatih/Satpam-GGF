<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="5dp">

    <RelativeLayout
        android:id="@+id/rltvhasil1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_layout_white_2"
        android:padding="3dp"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:id="@+id/crd1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/profile1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentLeft="true"
                android:src="@drawable/prfll"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/profile"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="Indra Yulianto"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="Pengamatan Chopper"
                    android:textSize="12sp"
                    android:textStyle="bold" />


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/crd2"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_below="@+id/crd1"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_background4"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/crd3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/crd2"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/mPG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mmedium"
                android:text="Plantation Group 1"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mLokasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mmedium"
                android:text="153D"
                android:textAlignment="textEnd"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/crd4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/crd3"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/layoutKur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/indicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:layout_weight="0"
                    android:src="@drawable/shape_indicator_active" />

                <TextView
                    android:id="@+id/mStatusVerif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disetujui"
                    android:textColor="@color/blue"
                    android:textSize="12sp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutKur2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/indicator2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:layout_weight="0"
                    android:src="@drawable/shape_indicator_active" />

                <TextView
                    android:id="@+id/mStatusVerif2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disetujui"
                    android:textColor="@color/blue"
                    android:textSize="12sp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutKur3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/indicator3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:layout_weight="0"
                    android:src="@drawable/shape_indicator_active" />

                <TextView
                    android:id="@+id/mStatusVerif3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disetujui"
                    android:textColor="@color/blue"
                    android:textSize="12sp" />


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/crd5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/crd4"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <LinearLayout

                android:id="@+id/layoutKur4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mStatusVerifKasie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disetujui"
                    android:textColor="@color/blue"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/indicatorKasie"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="0"
                    android:src="@drawable/shape_indicator_active" />

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/crd6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/crd5"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"

            >

            <LinearLayout
                android:id="@+id/layoutKur5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mStatusVerifKabag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disetujui"
                    android:textColor="@color/blue"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/indicatorKabag"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="0"
                    android:src="@drawable/shape_indicator_active" />

            </LinearLayout>

            <TextView
                android:id="@+id/mCreated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mmedium"
                android:text="25 Juni 2023"
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:textStyle="italic" />


        </LinearLayout>

        <Button
            android:id="@+id/mHapus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@id/crd6"
            android:text="Hapus"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btngradient3"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:drawableLeft="@drawable/baseline_delete_sweep_24"
            android:drawablePadding="8dp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>